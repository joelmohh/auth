<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Authorize ' + app.name }) %>
<body data-page="authorize">
  <main class="container min-vh-100 d-flex align-items-center justify-content-center py-4">
    <div class="card auth-card shadow w-100">
      <div class="card-body p-4 p-md-5">
        <div class="mb-4"><%- include('partials/brand') %></div>

        <div class="d-flex align-items-center gap-3 mb-1">
          <span class="avatar" style="width:2.5rem;height:2.5rem;font-size:1rem" aria-hidden="true"><%= app.name.slice(0, 2).toUpperCase() %></span>
          <h1 class="h5 mb-0"><%= app.name %></h1>
        </div>
        <p class="text-secondary mb-1">wants to access your account</p>
        <p class="form-text mb-4">Signed in as <strong data-user-name>…</strong></p>

        <hr class="my-4">

        <h2 class="h6 mb-3">This will allow <%= app.name %> to:</h2>
        <ul class="list-unstyled d-grid gap-3 mb-4">
          <% const SCOPE_INFO = {
            username: ['See your username', 'Your public @handle.'],
            email: ['See your email address', 'Includes whether it is verified.'],
            profile: ['See your profile', 'Display name, avatar, banner and bio.'],
            phone: ['See your phone number', 'Only if you added one.'],
            address: ['See your address', 'Only if you added one.'],
            birthDate: ['See your birth date', 'Only if you added one.']
          }; %>
          <% scopes.forEach(function (scope) { const info = SCOPE_INFO[scope] || ['Access: ' + scope, '']; %>
          <li class="d-flex gap-3">
            <span class="check check-on" style="pointer-events:none" aria-hidden="true"></span>
            <span>
              <span class="d-block" style="font-size:.925rem;font-weight:500"><%= info[0] %></span>
              <% if (info[1]) { %><span class="form-text"><%= info[1] %></span><% } %>
            </span>
          </li>
          <% }) %>
        </ul>

        <hr class="my-4">

        <p class="form-text mb-4">
          Once you authorize, you will be redirected to
          <strong class="mono"><%= new URL(redirect_uri).origin %></strong>.
          You can revoke this access at any time from your account page.
        </p>

        <div class="d-flex gap-2 justify-content-end">
          <button type="button" class="btn btn-outline theme-danger" id="denyBtn">Cancel</button>
          <button type="button" class="btn theme-brand btn-solid" id="allowBtn">Authorize</button>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/scripts') %>
  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const payload = {
        client_id: <%- JSON.stringify(client_id) %>,
        redirect_uri: <%- JSON.stringify(redirect_uri) %>,
        scope: <%- JSON.stringify(scopes.join(' ')) %>,
        state: <%- JSON.stringify(state || '') %>,
        code_challenge: <%- JSON.stringify(code_challenge || '') %>,
        code_challenge_method: <%- JSON.stringify(code_challenge_method || '') %>
      };

      const me = await Api.get('/api/me');
      if (!me.success) return;
      document.querySelector('[data-user-name]').textContent = me.data?.username || '';

      async function decide(decision, btn) {
        btn.disabled = true;
        const r = await Api.post('/oauth/authorize', { ...payload, decision });
        btn.disabled = false;
        if (r.success && r.redirectURL) return (location.href = r.redirectURL);
        showToast(r.message || 'Could not complete the authorization.', 'error');
      }

      document.getElementById('allowBtn').addEventListener('click', (e) => decide('allow', e.currentTarget));
      document.getElementById('denyBtn').addEventListener('click', (e) => decide('deny', e.currentTarget));
    });
  </script>
</body>
</html>
