<!--For fraud prupouses this file content was from the renamed authorize.html-->
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Authorize Placeholder
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL"
        crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/public/css/test.css">
</head>

<body>
    <main class="container min-vh-100 d-flex align-items-center justify-content-center py-4">
        <div class="card auth-card shadow p-6">
            <div class="card-body p-4">
                <header class="avatars">
                    <span class="avatar">AB</span>
                    <span class="dots">···</span>
                    <span class="avatar">CD</span>
                </header>

                <section class="title">
                    <h1>
                        Placeholder
                    </h1>
                    <p class="subtitle">want's to access you account</p>
                    <p class="signed-in">
                        Signed in as <strong>placehold</strong> <a href="/api/logout">Not you?</a>
                    </p>
                </section>

                <hr class="divider">

                <section class="permissions">
                    <h4 class="mt-5 mb-5">This will grant access to placeholder's owners to:</h3>
                        <div class="form-field mb-5">
                            <input type="checkbox" class="check" checked disabled />
                            <div class="form-field-content">
                                <label for="checkDescription">Your basic info</label>
                                <small class="form-text">E-mail address, username.</small>
                            </div>
                        </div>
                        <div class="form-field mb-5">
                            <input type="checkbox" class="check" checked disabled />
                            <div class="form-field-content">
                                <label for="checkDescription">Your profile info</label>
                                <small class="form-text">Full name, address etc.</small>
                            </div>
                        </div>
                        <div class="form-field mb-5">
                            <input type="checkbox" class="check" disabled />
                            <div class="form-field-content">
                                <label for="checkDescription">Your password</label>
                                <small class="form-text">Not doing that</small>
                            </div>
                        </div>
                </section>

                <hr class="divider">

                <section class="info">
                    <p class="form-text">Once you authorize you will be redirected to: <% app.redirectUrl %>
                    </p>
                    <p class="form-text">The developer's <a href="<%= app.ppUrl %>">privacy policy</a> and <a
                            href="<%= app.tosUrl %>">terms of service</a> apply to this
                        aplication</p>
                    <p class="form-text">Active since <%= app.creation %>
                    </p>
                </section>

                <footer class="form-field d-flex float-end">
                    <form method="post" action="/oauth/authorize">
                        <button type="submit" class="btn btn-solid theme-primary">Authorize</button>
                    </form>
                    <button type="submit" class="btn btn-outline theme-danger">Cancel</button>
                </footer>
            </div>
        </div>
    </main>
</body>

</html>