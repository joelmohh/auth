<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Reset password' }) %>
<body data-page="reset">
  <main class="container min-vh-100 d-flex align-items-center justify-content-center py-4">
    <div class="card auth-card shadow w-100">
      <div class="card-body p-4 p-md-5">
        <div class="mb-4"><%- include('partials/brand') %></div>

        <div data-view>
          <h1 class="h4 mb-1">Reset your password</h1>
          <p class="text-secondary mb-4">Enter your email and we'll send you a code.</p>
          <form id="emailForm" novalidate>
            <div class="form-field">
              <label for="email" class="form-label">Email address</label>
              <input type="email" class="form-control" id="email" name="email" required autocomplete="email" placeholder="you@example.com">
              <div class="invalid-feedback">Enter a valid email address.</div>
            </div>
            <button type="submit" class="btn theme-brand btn-solid w-100 mt-4">Send code</button>
          </form>
        </div>

        <div data-view class="d-none">
          <%- include('partials/otp', { label: 'Continue' }) %>
        </div>

        <div data-view class="d-none">
          <h1 class="h4 mb-1">Choose a new password</h1>
          <p class="text-secondary mb-4">Use at least 8 characters.</p>
          <form id="passForm" novalidate>
            <div class="form-field">
              <label for="newPassword" class="form-label">New password</label>
              <input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="8" autocomplete="new-password">
              <div class="strength-bar" data-bs-strength></div>
              <div class="invalid-feedback">Use at least 8 characters.</div>
            </div>
            <div class="form-field mt-4">
              <label for="confirmPassword" class="form-label">Confirm password</label>
              <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required data-match="#newPassword" autocomplete="new-password">
              <div class="invalid-feedback">Passwords do not match.</div>
            </div>
            <button type="submit" class="btn theme-brand btn-solid w-100 mt-4">Reset password</button>
          </form>
        </div>

        <p class="form-text text-center mt-4 mb-0">Changed your mind? <a href="/login">Back to sign in</a></p>
      </div>
    </div>
  </main>
  <%- include('partials/scripts') %>
  <script src="/js/auth.js"></script>
</body>
</html>
