<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Signup</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/public/css/test.css">
</head>

<body data-bs-theme="dark">
    <main class="container min-vh-100 d-flex align-items-center justify-content-center py-4">
        <div class="card auth-card shadow p-6">
            <div class="card-body p-4">

                <!-- Topo -->
                <section class="text-center mb-4">
                    <div>Signup</div>
                    <h1 class="fw-normal text-secondary mb-0">Create your account</h1>
                </section>

                <ol class="stepper stepper-horizontal">
                    <li class="stepper-item active step"></li>
                    <li class="stepper-item step"></li>
                    <li class="stepper-item step"></li>
                    <li class="stepper-item step"></li>
                </ol>

                <form action="/login" method="post" data-bs-validate novalidate>
                    <div id="step-1">
                        <h3 class="mt-5 mb-5">Required data</h3>
                        <div class="form-field flex-1">
                            <label for="email" class="form-label">Email address <span
                                    class="text-danger form-text">*</span></label>
                            <input type="email" class="form-control" id="email" placeholder="example@example.com">
                            <div class="invalid-feedback">Please enter a valid email address.</div>
                            <div class="valid-feedback">Looks good!</div>
                        </div>
                        <div class="form-field mt-5">
                            <label for="password" class="form-label">Password <span
                                    class="text-danger form-text">*</span></label>
                            <input type="password" class="form-control" id="password" placeholder="Enter password">
                            <div class="strength-bar" data-bs-strength></div>
                            <div class="invalid-feedback">Please enter a password.</div>
                            <div class="valid-feedback">Awesome!</div>
                        </div>
                        <div class="form-field mt-5">
                            <label for="passwordC" class="form-label">Password Confirmation <span
                                    class="text-danger form-text">*</span></label>
                            <input type="password" class="form-control" id="passwordC" placeholder="Re-enter password">
                            <div class="invalid-feedback">Please enter a password.</div>
                            <div class="valid-feedback">Awesome!</div>
                        </div>
                        <div class="form-field flex-1 mt-5">
                            <label for="username" class="form-label">Username <span
                                    class="text-danger form-text">*</span></label>
                            <input type="text" class="form-control" id="username" placeholder="jhondoe">
                            <div class="invalid-feedback">Please enter a username.</div>
                            <div class="valid-feedback">Looks good!</div>
                        </div>
                        <div class="form-field mt-5">
                            <input type="checkbox" id="terms" class="check" />
                            <div class="form-field-content">
                                <label for="terms">I agree to the ToS</label>
                            </div>
                            <div class="invalid-feedback">You have to agree with the ToS.</div>
                        </div>
                        <div class="form-field mt-5">
                            <button class="btn theme-primary btn-solid next-step">Next</button>
                        </div>
                    </div>
                    <div id="step-2" class="d-none">
                        <h2 class="mt-5 mb-5">Personal data</h2>
                        <div class="form-field flex-1">
                            <label for="name" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="name" placeholder="Jhon Doe">
                        </div>
                        <div class="form-field mt-5">
                            <label for="phone" class="form-label">Phone</label>
                            <input type="tel" class="form-control" id="phone" placeholder="+1 (111) 111-1111">
                        </div>
                        <div class="form-field mt-5">
                            <label for="address" class="form-label">Address</label>
                            <input type="text" class="form-control" id="address" placeholder="Enter your address">
                        </div>
                        <div class="form-field flex-1 mt-5">
                            <label for="datepicker1" class="form-label">Birthday</label>
                            <input type="text" class="form-control" id="datepicker1" data-bs-toggle="datepicker"
                                autocomplete="off" placeholder="Choose date…">
                        </div>
                        <div class="form-field mt-5">
                            <button class="btn theme-primary btn-solid w-100 next-step">Next</button>
                            <a class="previous-step text-center form-text" href="#">Go back</a>
                        </div>
                    </div>
                    <div id="step-3" class="d-none">
                        <h2 class="mt-5 mb-5">Cosmetic data</h2>
                        <div class="form-field flex-1">
                            <label for="name" class="form-label">Display name</label>
                            <input type="text" class="form-control" id="name" placeholder="Jhon Doe">
                        </div>
                        <div class="form-field mt-5">
                            <label for="avatarFile" class="form-label">Avatar</label>
                            <input type="file" class="form-control" id="avatarFile">
                        </div>
                        <div class="form-field mt-5">
                            <label for="bannerFile" class="form-label">Banner</label>
                            <input type="file" class="form-control" id="bannerFile">
                        </div>
                        <div class="form-field flex-1 mt-5">
                            <label for="datepicker1" class="form-label">Bio</label>
                            <textarea class="form-control" id="fieldTextarea" rows="3"></textarea>
                        </div>
                        <div class="form-field mt-5">
                            <button class="btn theme-primary btn-solid w-100 next-step">Signup</button>
                            <a class="text-center form-text previous-step" href="#">Go back</a>
                        </div>
                    </div>
                    <div id="step-4" class="d-none">
                        <h2 class="mt-5 mb-5">Verify your account</h2>
                        <div class="otp" data-bs-otp data-bs-groups="[3,3]">
                            <input type="text" class="otp-input w-100" maxlength="6" aria-label="Verification code">
                        </div>
                        <div class="form-field mt-5">
                            <button class="btn theme-primary btn-solid w-100 next-step">Verify</button>
                            <a class="resend-otp text-center form-text" href="#">Resend OTP (XXs)</a>
                        </div>
                    </div>

                </form>
                <span class="form-text mt-5">Already have an account? <a href="./login.html" class="">Login</a></span>
                <!-- Social logins -->
                <div class="divider my-4">or continue with</div>

                <div>
                    <div class="mb-5">
                        <a href="/auth/google" class="btn btn-lg theme-primary btn-outline w-100">
                            <span class="social-icon" aria-hidden="true">A</span> Google
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <script type="module"
        src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.querySelector('form')
            const stepEls = [1, 2, 3, 4].map(n => document.getElementById(`step-${n}`))
            const indicators = document.querySelectorAll('.stepper-item')
            const totalSteps = stepEls.length
            let currentStep = 0

            function showStep(i) {
                currentStep = i
                stepEls.forEach((el, idx) => el.classList.toggle('d-none', idx !== i))
                indicators.forEach((el, idx) => el.classList.toggle('active', idx <= i))
            }

            form.addEventListener('submit', (e) => {
                e.preventDefault()
                if (currentStep < totalSteps - 1) {
                    showStep(currentStep + 1)
                } else {
                    form.submit()
                }
            })

            document.querySelectorAll('.previous-step').forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault()
                    if (currentStep > 0) showStep(currentStep - 1)
                })
            })
        })
    </script>
</body>

</html>