<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Create account' }) %>
<body data-page="signup">
  <main class="container min-vh-100 d-flex align-items-center justify-content-center py-4">
    <div class="card auth-card shadow w-100">
      <div class="card-body p-4 p-md-5">
        <div class="mb-4"><%- include('partials/brand') %></div><div id="signupSummary" class="form-summary" role="alert" tabindex="-1" hidden></div>
        <h1 class="h4 mb-1">Create your account</h1>
        <p class="text-secondary mb-4">Welcome! Fill in the details to get started.</p>

        <ol class="steps mb-4" aria-hidden="true">
          <li class="steps-item active"></li>
          <li class="steps-item"></li>
          <li class="steps-item"></li>
        </ol>

        <form id="signupForm" novalidate>
          <div data-step>
            <div class="form-field">
              <label for="email" class="form-label">Email address <span aria-hidden="true">*</span></label>
              <input type="email" class="form-control" id="email" name="email" required autocomplete="email" placeholder="you@example.com">
              <div class="invalid-feedback">Enter a valid email address.</div>
            </div>
            <div class="form-field mt-4">
              <label for="username" class="form-label">Username <span aria-hidden="true">*</span></label>
              <input type="text" class="form-control" id="username" name="username" required minlength="3" maxlength="32" pattern="[A-Za-z0-9_.\-]+" autocomplete="username" placeholder="johndoe">
              <div class="invalid-feedback">3-32 characters: letters, numbers, dot, dash or underscore.</div>
            </div>
            <div class="form-field mt-4">
              <label for="password" class="form-label">Password <span aria-hidden="true">*</span></label>
              <input type="password" class="form-control" id="password" name="password" required minlength="8" maxlength="128" autocomplete="new-password" placeholder="At least 8 characters">
              <div class="strength-bar" data-bs-strength></div>
              <div class="invalid-feedback">Use at least 8 characters.</div>
            </div>
            <div class="form-field mt-4">
              <label for="passwordC" class="form-label">Confirm password <span aria-hidden="true">*</span></label>
              <input type="password" class="form-control" id="passwordC" name="passwordC" required data-match="#password" autocomplete="new-password" placeholder="Re-enter your password">
              <div class="invalid-feedback">Passwords do not match.</div>
            </div>
            <div class="form-field mt-4">
              <input type="checkbox" id="terms" name="terms" class="check" required>
              <div class="form-field-content">
                <label for="terms">I accept the <a href="/terms" target="_blank">terms of service</a> and the <a href="/privacy" target="_blank">privacy policy</a></label>
              </div>
              <div class="invalid-feedback">You must accept the terms to continue.</div>
            </div>
            <button type="submit" class="btn theme-brand btn-solid w-100 mt-4">Continue</button>
          </div>

          <div data-step class="d-none">
            <h2 class="h6 mb-3">Personal details <span class="text-secondary fw-normal">(optional)</span></h2>
            <div class="form-field">
              <label for="phone" class="form-label">Phone</label>
              <input type="tel" class="form-control" id="phone" name="phone" maxlength="20" pattern="[0-9+()\-\s]*" autocomplete="tel" placeholder="+1 555 000 0000">
              <div class="invalid-feedback">Enter a valid phone number.</div>
            </div>
            <div class="form-field mt-4">
              <label for="birthDate" class="form-label">Birth date</label>
              <input type="text" class="form-control" id="birthDate" name="birthDate" autocomplete="off" placeholder="Choose date…">
              <div class="invalid-feedback">Enter a valid date.</div>
            </div>
            <div class="form-field mt-4">
              <label for="city" class="form-label">City</label>
              <input type="text" class="form-control" id="city" name="city" maxlength="80" autocomplete="address-level2">
            </div>
            <div class="d-flex gap-3 mt-4">
              <div class="form-field flex-1">
                <label for="state" class="form-label">State</label>
                <input type="text" class="form-control" id="state" name="state" maxlength="80" autocomplete="address-level1">
              </div>
              <div class="form-field flex-1">
                <label for="country" class="form-label">Country</label>
                <input type="text" class="form-control" id="country" name="country" maxlength="80" autocomplete="country-name">
              </div>
            </div>
            <button type="submit" class="btn theme-brand btn-solid w-100 mt-4">Continue</button>
            <button type="button" class="btn btn-text w-100 mt-2" data-prev>Go back</button>
          </div>

          <div data-step class="d-none">
            <h2 class="h6 mb-3">Your profile <span class="text-secondary fw-normal">(optional)</span></h2>
            <div class="form-field">
              <label for="displayName" class="form-label">Display name</label>
              <input type="text" class="form-control" id="displayName" name="displayName" maxlength="64" placeholder="John Doe">
            </div>
            <div class="form-field mt-4">
              <label for="bio" class="form-label">Bio</label>
              <textarea class="form-control" id="bio" name="bio" rows="3" maxlength="280" placeholder="Tell us a bit about you"></textarea>
            </div>
            <button type="submit" class="btn theme-brand btn-solid w-100 mt-4">Create account</button>
            <button type="button" class="btn btn-text w-100 mt-2" data-prev>Go back</button>
          </div>
        </form>

        <%- include('partials/otp', { label: 'Verify' }) %>

        <p class="form-text text-center mt-4 mb-0">Already have an account? <a href="/login">Sign in</a></p>
      </div>
    </div>
  </main>
  <%- include('partials/scripts') %>
  <script src="/js/auth.js"></script>
</body>
</html>
