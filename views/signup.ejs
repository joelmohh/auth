<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head', { title: 'Create Account - Joelmo Auth Systems' }) -%>

<body>
    <div class="toast-container" aria-live="polite" aria-atomic="true"></div>
    <div class="auth-container">
        <div class="auth-logo">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M16 2L29 9V23L16 30L3 23V9L16 2Z" fill="#15616D" />
                <path d="M11 20L16 12L21 20H11Z" fill="#FFFFFF" />
            </svg>
            <span>Joelmo</span>
        </div>

        <div class="auth-card">
            <h2>Create your account</h2>
            <p class="auth-subtitle">Start in seconds, no credit card required</p>

            <div class="social-grid">
                <button type="button" class="btn-social" title="Continue with Google" aria-label="Continue with Google">
                    A <!-- Google SVG icon -->
                </button>
                <button type="button" class="btn-social" title="Continue with Apple" aria-label="Continue with Apple">
                    A <!-- Apple SVG icon -->
                </button>
                <button type="button" class="btn-social" title="Continue with Microsoft" aria-label="Continue with Microsoft">
                    A <!-- Microsoft SVG icon -->
                </button>
                <button type="button" class="btn-social" title="Continue with GitHub" aria-label="Continue with GitHub">
                        A <!-- Github SVG icon -->
                </button>
                <button type="button" class="btn-social" title="Continue with Discord" aria-label="Continue with Discord">
                    A <!-- Discord SVG icon -->
                </button>
                <button type="button" class="btn-social" title="Continue with X" aria-label="Continue with X">
                    A <!-- X SVG icon -->
                </button>
            </div>

            <div class="auth-divider">or sign up with email</div>

            <div class="step-indicator">
                <span class="step-dot active" data-step-dot="1">1</span>
                <span class="step-line"></span>
                <span class="step-dot" data-step-dot="2">2</span>
            </div>
            <p class="step-caption"><span data-step-caption>Step 1 of 2 &middot; required info</span></p>

            <form id="signup-form" novalidate>

                <!-- ===== Step 1: required data ===== -->
                <fieldset class="signup-step" data-step="1">
                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <input type="text" class="form-control" id="username" placeholder="joelmosilva" autocomplete="username">
                        <div id="username-error" class="text-danger"></div>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" placeholder="you@company.com" autocomplete="email">
                        <div id="email-error" class="text-danger"></div>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <div class="input-wrapper">
                            <input type="password" class="form-control" id="password" placeholder="Create a password" autocomplete="new-password">
                            <button type="button" class="input-icon-btn" aria-label="Show password">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                        <div class="password-strength" id="password-strength">
                            <div class="strength-segment"></div>
                            <div class="strength-segment"></div>
                            <div class="strength-segment"></div>
                            <div class="strength-segment"></div>
                        </div>
                        <p class="strength-label" id="strength-label">Use 8+ characters, a number and a symbol</p>
                        <div id="password-error" class="text-danger"></div>
                    </div>

                    <div class="mb-3">
                        <label for="confirm-password" class="form-label">Confirm password</label>
                        <div class="input-wrapper">
                            <input type="password" class="form-control" id="confirm-password"
                                placeholder="Repeat your password" autocomplete="new-password">
                            <button type="button" class="input-icon-btn" aria-label="Show password">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                        <div id="confirm-password-error" class="text-danger"></div>
                    </div>

                    <button type="button" id="signup-next" class="btn btn-primary">Next</button>
                </fieldset>

                <!-- ===== Step 2: optional data ===== -->
                <fieldset class="signup-step" data-step="2" hidden>
                    <p class="auth-subtitle">Optional &mdash; you can skip this and fill it later</p>

                    <div class="mb-3">
                        <label for="fullName" class="form-label">Full name</label>
                        <input type="text" class="form-control" id="fullName" placeholder="Joelmo Silva">
                    </div>

                    <div class="mb-3">
                        <label for="phone" class="form-label">Phone</label>
                        <input type="tel" class="form-control" id="phone" placeholder="+55 11 90000-0000">
                    </div>

                    <div class="mb-3">
                        <label for="address" class="form-label">Address</label>
                        <input type="text" class="form-control" id="address" placeholder="Street, city">
                    </div>

                    <div class="mb-3">
                        <label for="birthday" class="form-label">Birthday</label>
                        <input type="date" class="form-control" id="birthday">
                    </div>

                    <div class="mb-3">
                        <label for="bio" class="form-label">Bio</label>
                        <input type="text" class="form-control" id="bio" placeholder="Tell us a bit about you">
                    </div>

                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" id="terms">
                        <label class="form-check-label auth-terms" for="terms">
                            I agree to the <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>
                        </label>
                        <div id="terms-error" class="text-danger"></div>
                    </div>

                    <div class="step-actions">
                        <button type="button" id="signup-back" class="btn btn-secondary">Back</button>
                        <button type="submit" id="signup-button" class="btn btn-primary">Create account</button>
                    </div>
                </fieldset>
            </form>

            <div class="auth-footer">
                Already have an account? <a href="/login">Log in</a>
            </div>
        </div>
    </div>
</body>
<%- include('./partials/scripts') -%>

</html>