<!DOCTYPE html>
<html lang="pt-br">

<%- include('./partials/head') -%>

    <body>
        <div class="toast-container"></div>
        <div class="auth-container">
            <div class="auth-logo">
                <!-- SVG logo -->
                <span>Joelmo</span>
            </div>

            <div class="auth-card">
                <h2>Login in</h2>
                <p class="auth-subtitle">Enter your credentials to access your account</p>

                <div class="social-grid">
                    <button type="button" class="btn-social" title="Continue with Google"
                        aria-label="Continue with Google">
                        A <!-- Google SVG icon -->
                    </button>
                    <button type="button" class="btn-social" title="Continue with Apple"
                        aria-label="Continue with Apple">
                        A <!-- Apple SVG icon -->
                    </button>
                    <button type="button" class="btn-social" title="Continue with Microsoft"
                        aria-label="Continue with Microsoft">
                        A <!-- Microsoft SVG icon -->
                    </button>
                    <button type="button" class="btn-social" title="Continue with GitHub"
                        aria-label="Continue with GitHub">
                        A <!-- Github SVG icon -->
                    </button>
                    <button type="button" class="btn-social" title="Continue with Discord"
                        aria-label="Continue with Discord">
                        A <!-- Discord SVG icon -->
                    </button>
                    <button type="button" class="btn-social" title="Continue with X" aria-label="Continue with X">
                        A <!-- X SVG icon -->
                    </button>
                </div>

                <div class="auth-divider">or continue with email</div>

                <form id="login-form">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" placeholder="example@company.com">
                        <div id="email-error" class="text-danger"></div>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <div class="input-wrapper">
                            <input type="password" class="form-control" id="password" placeholder="Create a password">
                            <button type="button" class="input-icon-btn" aria-label="Show password">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="remember">
                            <label class="form-check-label" for="remember">Remember me</label>
                        </div>
                        <a href="/reset-password" class="" style="font-size: 13px;">Forgot your password?</a>
                    </div>

                    <button id="login-button" type="submit" class="btn btn-primary">Login</button>
                </form>

                <div class="auth-footer">
                    Don't have an account? <a href="/signup">Create an account</a>
                </div>
            </div>
        </div>
    </body>
    <%- include('./partials/scripts') -%>
</html>