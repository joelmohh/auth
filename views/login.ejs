<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/public/css/test.css">
</head>

<body data-bs-theme="dark">
  <main class="container min-vh-100 d-flex align-items-center justify-content-center py-4">
    <div class="card auth-card shadow p-6">
      <div class="card-body p-4">

        <!-- Topo -->
        <section class="text-center mb-4">
          <div>Login</div>
          <h1 class="fw-normal text-secondary mb-0">Access your account</h1>
        </section>

        <form action="/login" method="post" data-bs-validate novalidate>
          <div class="form-field flex-1">
            <label for="fieldValidateEmail" class="form-label">Email address</label>
            <input type="email" class="form-control" id="fieldValidateEmail" required placeholder="example@example.com">
            <div class="invalid-feedback">Please enter a valid email address.</div>
            <div class="valid-feedback">Looks good!</div>
          </div>

          <div class="form-field mt-5">
            <div class="d-flex justify-content-between align-items-center">
              <label for="password" class="form-label">Password</label>
              <span class="form-text forgot-text">Forgot your password? <a href="#">Click here</a></span>
            </div>
            <input type="password" class="form-control" id="password" placeholder="Enter password" required>
            <div class="invalid-feedback">Please enter a password.</div>
            <div class="valid-feedback">Awesome!</div>
          </div>

          <div class="form-field mt-5">
            <input type="checkbox" id="fieldValidateCheck" class="check">
            <div class="form-field-content">
              <label for="fieldValidateCheck">Remember me</label>
            </div>
          </div>
          <div class="form-field mt-6">
            <button class="btn theme-primary btn-solid">Login</button>
          </div>
        </form>

        <div id="verifyOtpInput" class="d-none">
            <h2 class="mt-5 mb-5">Verify your account</h2>
            <p class="form-text">
              We sended an code to  <strong>${email}</strong>. What's the code?
            </p>
            <div class="otp" data-bs-otp data-bs-groups="[3,3]">
              <input type="text" class="otp-input w-100" maxlength="6" aria-label="Verification code">
            </div>
            <div class="form-field mt-5">
              <button class="btn theme-primary btn-solid w-100 next-step">Verify</button>
              <a class="resend-otp text-center form-text" href="#">Resend OTP (XXs)</a>
            </div>
          </div>

        <span class="form-text">Don' t have an account yet? <a href="./signup.html" class="">Create one</a></span>

          <!-- Social logins -->
          <div class="divider my-4">or continue with</div>

          <div>
            <div class="mb-5">
              <a href="/auth/google" class="btn btn-lg theme-primary btn-outline w-100">
                <span class="social-icon" aria-hidden="true">A</span> Google
              </a>
            </div>
          </div>

        </div>
      </div>
  </main>

  <!-- Bootstrap 6: JS é ESM-only, precisa de type="module" -->
  <script type="module"
    src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const toggle = document.getElementById('toggle');
    const password = document.getElementById('password');

    toggle.addEventListener('click', () => {
      const show = password.type === 'password';
      password.type = show ? 'text' : 'password';
      toggle.setAttribute('aria-pressed', show);
      toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    });
  </script>
</body>

</html>