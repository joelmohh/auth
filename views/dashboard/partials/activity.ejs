<p class="h4"><%= activity.total %> sign-ins in retained records</p><% if (!activity.total) { %><p class="form-text">No initial OAuth token issues found for this period in retained records.</p><% } %><div class="activity-bars" aria-hidden="true"><% const max = Math.max(1, ...activity.series.map(day => day.count)); activity.series.forEach(day => { %><div class="activity-day" title="<%= day.date %>: <%= day.count %>"><div class="activity-bar" style="height:<%= Math.max(1,day.count/max*85) %>%"></div><span><%= day.date.slice(5) %></span></div><% }) %></div><details class="activity-table"><summary>View daily counts</summary><table class="table-simple"><caption class="visually-hidden">Daily sign-in counts in UTC</caption><thead><tr><th>Date (UTC)</th><th>Count</th></tr></thead><tbody><% activity.series.forEach(day => { %><tr><td><%= day.date %></td><td><%= day.count %></td></tr><% }) %></tbody></table></details>