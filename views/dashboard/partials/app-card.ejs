<div class="app-grid-item"><a class="card app-entry" data-select href="/dashboard/apps/<%= app._id %>"><div class="app-banner"><% if (h.imageUrl(app.theme?.bannerUrl)) { %><img class="banner-image" src="<%= h.imageUrl(app.theme.bannerUrl) %>" alt=""><% } %></div><div class="app-avatar"><%- include('avatar', {name:app.name, image:app.theme?.logoUrl}) %></div><div class="card-body"><div class="entry-title"><h3 class="h6" data-name><%= app.name %></h3><span class="badge badge-subtle <%= app.status === 'active' ? 'badge-success' : 'badge-danger' %>" data-status><%= app.status %></span></div><p class="form-text" data-description><%= app.description || 'Configure authentication for this app.' %></p><span class="entry-action">Open application <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></div></a></div>