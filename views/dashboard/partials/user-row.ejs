<% const person=item.user; const name=person.profile?.displayName || person.username || person.email || person.id; %><tr data-user-id="<%= person.id %>"><td><div class="user-cell"><span class="avatar"><%- include('avatar', {name,image:person.profile?.avatarUrl}) %></span><div><div class="user-name"><%= name %></div><% if (item.banned) { %><span class="badge badge-danger">Banned<%= item.bannedUntil ? ' until ' + h.fmtDate(item.bannedUntil) : '' %></span><% } %><% if (person.email && person.username) { %><div class="user-email"><%= person.email %></div><% } %></div></div></td><td><% (item.scopes || []).forEach(scope => { %><span class="scope-badge"><%= scope %></span><% }) %></td><td class="text-end"><button type="button" class="btn btn-text btn-sm"><i class="fa-solid fa-user-minus" aria-hidden="true"></i> Revoke</button><button type="button" class="btn btn-text theme-danger btn-sm"><i class="fa-solid <%= item.banned ? 'fa-unlock' : 'fa-gavel' %>" aria-hidden="true"></i> <%= item.banned ? 'Unban' : 'Ban' %></button></td></tr>