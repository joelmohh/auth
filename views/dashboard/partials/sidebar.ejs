<div class="sidebar-stack">
  <a class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>" href="/dashboard"><i class="fa-solid fa-house fa-fw" aria-hidden="true"></i>Overview</a>
  <a class="nav-link <%= currentPath === '/dashboard/apps' ? 'active' : '' %>" href="/dashboard/apps"><i class="fa-solid fa-grip fa-fw" aria-hidden="true"></i>Apps</a>
  <div data-app-context>
    <p class="nav-caption">APPLICATION</p>
    <div class="app-select"><i class="fa-solid fa-layer-group app-select-icon" aria-hidden="true"></i><select class="form-control" data-app-select aria-label="Selected app" <%= !dashboard.apps.length ? 'disabled' : '' %>><option value="" <%= !dashboard.selectedApp ? 'selected' : '' %>><%= dashboard.apps.length ? 'Select app' : 'No apps yet' %></option><% dashboard.apps.forEach(app => { %><option value="<%= app._id %>" <%= dashboard.selectedApp?._id === app._id ? 'selected' : '' %>><%= app.name %></option><% }) %></select><i class="fa-solid fa-chevron-down app-select-caret" aria-hidden="true"></i></div>
    <nav aria-label="Application"><a class="nav-link" data-app-link="" <% if (dashboard.selectedApp) { %>href="/dashboard/apps/<%= dashboard.selectedApp._id %>"<% } else { %>aria-disabled="true"<% } %>>Details</a><a class="nav-link" data-app-link="users" <% if (dashboard.selectedApp) { %>href="/dashboard/apps/<%= dashboard.selectedApp._id %>/users"<% } else { %>aria-disabled="true"<% } %>>Users</a><a class="nav-link" data-app-link="settings" <% if (dashboard.selectedApp) { %>href="/dashboard/apps/<%= dashboard.selectedApp._id %>/settings"<% } else { %>aria-disabled="true"<% } %>>Settings</a><a class="nav-link" data-app-link="#docs" <% if (dashboard.selectedApp) { %>href="/dashboard/apps/<%= dashboard.selectedApp._id %>#docs"<% } else { %>aria-disabled="true"<% } %>>Documentation</a><a class="nav-link" data-app-link="#playground" <% if (dashboard.selectedApp) { %>href="/dashboard/apps/<%= dashboard.selectedApp._id %>#playground"<% } else { %>aria-disabled="true"<% } %>>Playground</a></nav>
  </div>
  <div class="sidebar-bottom"><a class="nav-link <%= currentPath === '/dashboard/account' ? 'active' : '' %>" href="/dashboard/account"><i class="fa-regular fa-circle-user fa-fw" aria-hidden="true"></i>Account</a></div>
</div>
