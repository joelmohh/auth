<!doctype html>
<html lang="en" data-bs-theme="dark"><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your apps</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css">
  </head>
<body>

  <header class="app-header">
    <div class="container d-flex align-items-center justify-content-between py-3">
      <a class="brand" href="#">
        <span class="brand-mark" aria-hidden="true"></span>
        LOGO
      </a>

      <div class="position-relative">
        <button class="btn btn-text user-toggle" type="button" data-bs-toggle="menu" aria-label="Account menu">
          <span class="avatar">U</span>
          <span class="username">user.username</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </button>
        <div class="menu">
          <button class="menu-item" type="button">Profile</button>
          <button class="menu-item" type="button">Settings</button>
          <hr class="menu-divider">
          <button class="menu-item theme-danger" type="button">Log out</button>
        </div>
      </div>
    </div>
  </header>

  <main class="container py-5">

    <div class="page-head d-flex align-items-start justify-content-between gap-3 mb-4">
      <div>
        <h1 class="h2 mb-1">Your apps</h1>
        <p class="app-meta mb-0">See, create and manage your apps</p>
      </div>
      <button class="btn btn-solid btn-brand" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
        New App
      </button>
    </div>

    <form class="toolbar mb-4" role="search" onsubmit="return false">
      <div class="form-control form-adorn search">
        <span class="form-adorn-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
        </span>
        <input class="form-ghost" type="search" placeholder="Search" aria-label="Search apps">
      </div>
      <select class="form-control" aria-label="Filter 1">
        <option selected="">Filter 1</option>
        <option>Option A</option>
        <option>Option B</option>
      </select>
      <select class="form-control" aria-label="Filter 2">
        <option selected="">Filter 2</option>
        <option>Option A</option>
        <option>Option B</option>
      </select>
    </form>

    <div class="grid row-gap-4">
      <div class="g-col-12 sm:g-col-6 lg:g-col-4">
        <div class="card app-card">
          <div class="app-banner"></div>
          <div class="app-avatar">A</div>
          <div class="card-body pt-3">
            <h2 class="h6 mb-1">app.name</h2>
            <p class="app-meta mb-0">Updated 3 days ago</p>
          </div>
          <div class="card-footer d-flex justify-content-end border-0 pt-0">
            <button class="btn btn-solid btn-brand btn-sm" type="button">Select</button>
          </div>
        </div>
      </div>

      <div class="g-col-12 sm:g-col-6 lg:g-col-4">
        <div class="card app-card">
          <div class="app-banner"></div>
          <div class="app-avatar">A</div>
          <div class="card-body pt-3">
            <h2 class="h6 mb-1">app.name</h2>
            <p class="app-meta mb-0">Updated 1 week ago</p>
          </div>
          <div class="card-footer d-flex justify-content-end border-0 pt-0">
            <button class="btn btn-solid btn-brand btn-sm" type="button">Select</button>
          </div>
        </div>
      </div>

      <div class="g-col-12 sm:g-col-6 lg:g-col-4">
        <div class="card app-card">
          <div class="app-banner"></div>
          <div class="app-avatar">A</div>
          <div class="card-body pt-3">
            <h2 class="h6 mb-1">app.name</h2>
            <p class="app-meta mb-0">Updated 2 weeks ago</p>
          </div>
          <div class="card-footer d-flex justify-content-end border-0 pt-0">
            <button class="btn btn-solid btn-brand btn-sm" type="button">Select</button>
          </div>
        </div>
      </div>
    </div>

    <nav class="mt-5" aria-label="Apps pages">
      <ul class="pagination theme-brand mb-0">
        <li class="page-item disabled"><a class="page-link" href="#" aria-disabled="true">Previous</a></li>
        <li class="page-item"><a class="page-link active" href="#" aria-current="page">1</a></li>
        <li class="page-item"><a class="page-link" href="#">2</a></li>
        <li class="page-item"><a class="page-link" href="#">3</a></li>
        <li class="page-item"><a class="page-link" href="#">Next</a></li>
      </ul>
    </nav>

  </main>

  <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"></script>


</body></html>