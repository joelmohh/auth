<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Overview' }) %>
<body data-page="dashboard">
  <%- include('partials/menu') %>
  <div class="layout">
    <nav class="sidebar d-none lg:d-block" aria-label="Navigation">
      <%- include('partials/sidebar') %>
    </nav>
    <main class="p-4 p-md-5">
      <h1 class="h4 mb-4">Overview</h1>
      <div class="grid row-gap-4 mb-4">
        <div class="g-col-12 md:g-col-4"><div class="card"><div class="card-body">
          <p class="text-secondary mb-1">Apps</p><p class="h3 mb-0" data-stat="apps">–</p>
        </div></div></div>
        <div class="g-col-12 md:g-col-4"><div class="card"><div class="card-body">
          <p class="text-secondary mb-1">Active apps</p><p class="h3 mb-0" data-stat="active">–</p>
        </div></div></div>
        <div class="g-col-12 md:g-col-4"><div class="card"><div class="card-body">
          <p class="text-secondary mb-1">Providers enabled</p><p class="h3 mb-0" data-stat="providers">–</p>
        </div></div></div>
      </div>
      <div class="card mb-4">
        <div class="card-body">
          <h2 class="h6 mb-1">Get started</h2>
          <p class="text-secondary">Create an app to get a client ID and secret, then point it to <span class="mono">/oauth/authorize</span> to start signing users in.</p>
          <a class="btn theme-brand btn-solid btn-sm" href="/dashboard/apps">Manage apps</a>
        </div>
      </div>
      <div class="card">
        <div class="card-body">
          <h2 class="h6 mb-1">Activity</h2>
          <p class="text-secondary mb-0">Sign-ins over time will show up here once the analytics endpoint exists.</p>
          <div class="d-flex align-items-center justify-content-center text-secondary" style="min-height:10rem">No data yet</div>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/scripts') %>
  <script src="/js/dashboard.js"></script>
</body>
</html>
