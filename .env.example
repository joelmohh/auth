# Banco e sessões
MONGO_URI=mongodb://localhost:27017/auth
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
# Chave para criptografar secrets de provedores (AES-256): precisa ter exatamente 32 caracteres
CLIENT_SECRET_HASH=0123456789abcdef0123456789abcdef
# Opcionais
PORT=3000
NODE_ENV=development
COOKIE_SAME_SITE=lax
# E-mail (desligado por padrão em dev; o OTP sai no console)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# Login social (stubs; sem estas vars o botão mostra aviso)
# GOOGLE_REDIRECT_URL=
